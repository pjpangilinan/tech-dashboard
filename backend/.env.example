# Tech Dashboard Environment Variables
# Copy this file to .env and fill in your values

# Groq AI Settings (FREE, HIGH LIMITS)
# Get your free API key at: https://console.groq.com/keys
# Rate limit: 14,400 requests/minute
GROQ_API_KEY=your_groq_api_key_here

# Database URL (default: SQLite - can switch to PostgreSQL for production)
# DATABASE_URL=postgresql://user:password@db:5432/tech_dashboard

# CORS Origins (comma-separated, use * for all in dev)
CORS_ORIGINS=*

# Refresh interval in seconds (how often to fetch new articles)
REFRESH_INTERVAL=300